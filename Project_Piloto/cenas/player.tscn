[sub_resource type="GDScript" id="GDScript_unwft"]
resource_name = "Player"
script/source = "extends CharacterBody3D

# Referências
@onready var camera_pivot: Node3D = $CameraPivot
@onready var skin: Node3D = $ninja
@onready var anim_player: AnimationPlayer = $AnimationPlayer # Referência ao AnimationPlayer

# Configurações de Movimento
const SPEED = 10.0
const JUMP_VELOCITY = 4.5
const ACCELERATION = 15.0

@export var mouse_sensitivity: float = 0.003
@export var min_pitch: float = -35.0
@export var max_pitch: float = 20.0

var last_movement_dir: Vector3 = Vector3.BACK

func _ready() -> void:
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)

func _physics_process(delta: float) -> void:
	# 1. Gravidade e Pulo
	if not is_on_floor():
		velocity += get_gravity() * delta

	if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():
		velocity.y = JUMP_VELOCITY

	# 2. Direção do Movimento
	var input_dir: Vector2 = Input.get_vector(\"ui_left\", \"ui_right\", \"ui_up\", \"ui_down\")
	var main_camera: Camera3D = get_viewport().get_camera_3d()
	
	var direction: Vector3 = Vector3.ZERO
	if main_camera and input_dir != Vector2.ZERO:
		var forward: Vector3 = main_camera.global_transform.basis.z
		var right: Vector3 = main_camera.global_transform.basis.x
		
		direction = (forward * input_dir.y + right * input_dir.x).normalized()
		direction.y = 0.0

	# 3. Aplicação do Movimento
	var y_velocity = velocity.y
	velocity.y = 0.0
	
	if direction != Vector3.ZERO:
		velocity = velocity.move_toward(direction * SPEED, ACCELERATION * delta)
	else:
		velocity = velocity.move_toward(Vector3.ZERO, ACCELERATION * delta)
		
	velocity.y = y_velocity

	# 4. Rotação do Modelo
	if direction.length() > 0.1:
		last_movement_dir = direction
		
	var target_angle = Vector3.BACK.signed_angle_to(last_movement_dir, Vector3.UP)
	skin.global_rotation.y = lerp_angle(skin.global_rotation.y, target_angle, ACCELERATION * delta)

	move_and_slide()

	# 5. TROCA DE ANIMAÇÕES
	var anim_suffix = \"\"
	var is_moving = Vector3(velocity.x, 0, velocity.z).length() > 0.5

	if not is_on_floor():
		anim_suffix = \"Jump\"
	elif is_moving:
		anim_suffix = \"Jog_Fwd\" if anim_player.has_animation(\"Jog_Fwd\") or _has_anim_ending_with(\"Jog_Fwd\") else \"Walk\"
	else:
		anim_suffix = \"Idle\"

	_play_anim(anim_suffix)

# Função auxiliar para rodar a animação mesmo com prefixo de biblioteca
func _play_anim(anim_name: String) -> void:
	for a in anim_player.get_animation_list():
		if a == anim_name or a.ends_with(\"/\" + anim_name):
			if anim_player.current_animation != a:
				anim_player.play(a)
			return

func _has_anim_ending_with(anim_name: String) -> bool:
	for a in anim_player.get_animation_list():
		if a == anim_name or a.ends_with(\"/\" + anim_name):
			return true
	return false
"

